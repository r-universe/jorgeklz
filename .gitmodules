[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "moc.gapbk"]
	path = moc.gapbk
	url = https://github.com/jorgeklz/package-moc.gapbk
[submodule "momst"]
	path = momst
	url = https://github.com/jorgeklz/momst
[submodule "mstknnclust"]
	path = mstknnclust
	url = https://github.com/jorgeklz/package-mstknnclust
